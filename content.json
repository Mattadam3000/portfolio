        ]
      },
      "body": [
        {
          "kind": "prose",
          "heading": "Objects",
          "heading_class": "big",
          "fact": "Photographs become things you can hold, unfold, wear, and read. The packaging is part of the work. Each object turns a hidden system—appetite, status, consumption, body control—into something physical.",
          "class": "series-head r"
        },
